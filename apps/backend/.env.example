# ========================================
# Nightasaur Backend - Environment Template
# ========================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# === Server ===
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1

# === Database ===
# PostgreSQL (required for local + production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nightasaur?schema=public

# === JWT Auth ===
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# === Default Accounts (development only) ===
DEFAULT_ADMIN_EMAIL=admin@nightasaur.com
DEFAULT_ADMIN_PASSWORD=admin123!
DEFAULT_DEMO_EMAIL=demo@nightasaur.com
DEFAULT_DEMO_PASSWORD=demo1234

# === Facebook / Instagram (optional) ===
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# === AI Engine (local services) ===
AI_ENGINE_URL=http://localhost:8000
COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434

# === LLM (Local Inference) ===
# Values: ollama | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=30000

# === Uploads ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50