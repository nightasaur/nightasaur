generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  username              String                @unique
  passwordHash          String
  avatarUrl             String?
  bio                   String?
  role                  String                @default("PLAYER")
  trainerXp             Int                   @default(0)
  trainerLevel          Int                   @default(1)
  gems                  Int                   @default(0)
  coins                 Int                   @default(0)
  isActive              Boolean               @default(true)
  activeSpiritId        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  LanguagePreference    LanguagePreference?
  UserSettings          UserSettings?
  PasswordResetToken    PasswordResetToken[]
  Spirits               Spirit[]
  UserItems             UserItem[]
  Quests                QuestProgress[]
  Sessions              Session[]
  GenerationTasks       GenerationTask[]
  Squad                 Squad?
  LearningSessions      LearningSession[]
  UserAchievements      UserAchievement[]
  UserLanguageHistories UserLanguageHistory[]
  LearningProgress      LearningProgress[]
  PlayerLocation        PlayerLocation?
  SocialPosts           SocialPost[]
  LocationVisits        LocationVisit[]
  HatchingRecords       HatchingRecord[]
  ARCaptures            ARCapture[]
  EnglishConversations  EnglishConversation[]
  EnglishLearningProgress EnglishLearningProgress[]
  ActionLogs            ActionLog[]
  UserWoocommerce       UserWoocommerce?

  @@map("users")
}

model LanguagePreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  primaryLang      String  @default("zh-TW")
  secondaryLang    String?
  displayMode      String  @default("SINGLE")
  fontSize         Int     @default(16)
  theme            String  @default("LIGHT")
  autoDetect       Boolean @default(true)
  showRomanization Boolean @default(false)
  showPinyin       Boolean @default(false)
  showEnglishHint  Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("language_preferences")
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicVolume       Int      @default(70)
  soundVolume       Int      @default(80)
  musicEnabled      Boolean  @default(true)
  soundEnabled      Boolean  @default(true)
  vibrationEnabled  Boolean  @default(true)
  vibrationStrength Int      @default(50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_settings")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Squad {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("?????拆????")
  maxSize   Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members SquadMember[]

  @@map("squads")
}

model SquadMember {
  id        String          @id @default(cuid())
  squadId   String
  spiritId  String          @unique
  position  Int
  isActive  Boolean         @default(false)
  joinedAt  DateTime        @default(now())
  squad     Squad           @relation(fields: [squadId], references: [id], onDelete: Cascade)
  spirit    Spirit          @relation(fields: [spiritId], references: [id], onDelete: Cascade)
  trainings SquadTraining[]

  @@map("squad_members")
}

model SquadTraining {
  id           String      @id @default(cuid())
  memberId     String
  trainingType String
  xp           Int         @default(0)
  level        Int         @default(1)
  lastTrained  DateTime    @default(now())
  createdAt    DateTime    @default(now())
  member       SquadMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("squad_trainings")
}

model Spirit {
  id                   String                 @id @default(cuid())
  userId               String
  name                 String
  element              String
  species              String?
  personality          String?
  appearance           String?
  stage                String                 @default("EGG")
  level                Int                    @default(1)
  experience           Int                    @default(0)
  stats                String                 @default("{}")
  skills               String                 @default("[]")
  customization        String                 @default("{}")
  backstory            String?
  imageUrl             String?
  displayIcon          String?
  currentEmotion       String?
  lastComfortAt        DateTime?
  isActive             Boolean                @default(true)
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  evolutions           Evolution[]
  conversations        Conversation[]
  memories             SpiritMemory[]
  generationTasks      GenerationTask[]
  squadMember          SquadMember?
  learningSessions     LearningSession[]
  SpiritPuzzleProgress SpiritPuzzleProgress[]
  HatchingRecord       HatchingRecord[]
  HatchingInteraction  HatchingInteraction[]
  SocialPost           SocialPost[]
  LocationVisit        LocationVisit[]
  ARCapture            ARCapture[]
  upgrades             SpiritUpgrade[]
  EnglishConversations EnglishConversation[]

  @@map("spirits")
}

model Item {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  type        String
  rarity      String     @default("COMMON")
  effect      String?
  iconUrl     String?
  price       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  UserItems   UserItem[]

  @@map("items")
}

model UserItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_items")
}

model LocationSpawn {
  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  radius      Float    @default(100.0)
  spawnRate   Float    @default(0.5)
  element     String?
  minLevel    Int      @default(1)
  maxLevel    Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type             String?
  rarity           String    @default("COMMON")
  availableSpirits String?
  activeSpawn      String?
  spawnStartTime   DateTime?
  spawnEndTime     DateTime?
  cooldownHours    Int       @default(24)
  visits      LocationVisit[]
  captures    ARCapture[]

  @@unique([name, latitude, longitude])
  @@map("location_spawns")
}

model Quest {
  id            String          @id @default(cuid())
  title         String
  description   String
  type          String
  difficulty    String          @default("EASY")
  requirement   String          @default("{}")
  reward        String          @default("{}")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  QuestProgress QuestProgress[]

  @@map("quests")
}

model QuestProgress {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  claimed     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@map("quest_progress")
}

model SpiritUpgrade {
  id          String   @id @default(cuid())
  spiritId    String
  upgradeType String
  level       Int      @default(1)
  xp          Int      @default(0)
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spirit Spirit @relation(fields: [spiritId], references: [id], onDelete: Cascade)

  @@unique([spiritId, upgradeType])
  @@map("spirit_upgrades")
}

model Evolution {
  id          String   @id @default(cuid())
  spiritId    String
  fromStage   String
  toStage     String
  imageUrl    String?
  triggeredBy String?
  createdAt   DateTime @default(now())
  spirit      Spirit   @relation(fields: [spiritId], references: [id], onDelete: Cascade)

  @@map("evolutions")
}

model Conversation {
  id          String   @id @default(cuid())
  spiritId    String
  userMessage String
  aiResponse  String
  sentiment   String?
  createdAt   DateTime @default(now())
  spirit      Spirit   @relation(fields: [spiritId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model GenerationTask {
  id          String    @id @default(cuid())
  spiritId    String?
  userId      String
  taskType    String
  inputPrompt String
  resultUrl   String?
  status      String    @default("PENDING")
  errorMsg    String?
  metadata    String?
  queueJobId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  spirit      Spirit?   @relation(fields: [spiritId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generation_tasks")
}

model LearningSession {
  id              String    @id @default(cuid())
  userId          String
  spiritId        String?
  courseId        String
  totalQuestions  Int
  currentQuestion Int       @default(0)
  correctCount    Int       @default(0)
  questions       String
  answers         String?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spirit          Spirit?   @relation(fields: [spiritId], references: [id], onDelete: SetNull)

  @@map("learning_sessions")
}

model Achievement {
  id              String            @id @default(cuid())
  code            String            @unique
  title           String
  description     String
  emoji           String?
  category        String
  tier            String            @default("BRONZE")
  requirement     String            @default("{}")
  reward          String            @default("{}")
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  UserAchievement UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  unlocked      Boolean     @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Translation {
  id          String   @id @default(cuid())
  key         String
  module      String
  zhTW        String
  zhCN        String
  enUS        String
  jaJP        String?
  koKR        String?
  description String?
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, module])
  @@map("translations")
}

model UserLanguageHistory {
  id        String   @id @default(cuid())
  userId    String
  fromLang  String
  toLang    String
  action    String   @default("CHANGE")
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_language_history")
}

model LearningProgress {
  id            String    @id @default(cuid())
  userId        String
  category      String
  completed     Int       @default(0)
  correct       Int       @default(0)
  attempts      Int       @default(0)
  lastCompleted DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("learning_progress")
}

model DailyPuzzle {
  id          String      @id @default(cuid())
  puzzleId    String
  date        DateTime
  streakBonus Int?        @default(0)
  puzzle      PuzzleLevel @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([date])
  @@map("daily_puzzles")
}

model PuzzleLevel {
  id                   String                 @id @default(cuid())
  title                String
  description          String
  type                 String
  difficulty           String                 @default("MEDIUM")
  puzzleData           String
  solution             String
  reward               String
  unlockLevel          Int                    @default(1)
  timeLimit            Int                    @default(300)
  attempts             Int                    @default(0)
  completed            Int                    @default(0)
  successRate          Float                  @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  dailyPuzzles         DailyPuzzle[]
  spiritPuzzleProgress SpiritPuzzleProgress[]

  @@map("puzzle_levels")
}

model SpiritPuzzleProgress {
  id          String      @id @default(cuid())
  spiritId    String
  puzzleId    String
  attempts    Int         @default(0)
  completed   Boolean     @default(false)
  bestTime    Int?
  score       Int         @default(0)
  lastAttempt DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  spirit      Spirit      @relation(fields: [spiritId], references: [id], onDelete: Cascade)
  puzzle      PuzzleLevel @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([spiritId, puzzleId])
  @@map("spirit_puzzle_progress")
}

model HatchingRecord {
  id                 String    @id @default(cuid())
  spiritId           String
  userId             String
  startTime          DateTime
  endTime            DateTime?
  status             String
  initialTemperature Float
  initialHumidity    Float
  finalTemperature   Float?
  finalHumidity      Float?
  finalProgress      Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  spirit             Spirit    @relation(fields: [spiritId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hatching_records")
}

model HatchingInteraction {
  id              String   @id @default(cuid())
  spiritId        String
  interactionType String
  progressBefore  Float
  progressAfter   Float
  temperature     Float
  humidity        Float
  intensity       Float?   @default(1.0)
  createdAt       DateTime @default(now())
  spirit          Spirit   @relation(fields: [spiritId], references: [id], onDelete: Cascade)

  @@map("hatching_interactions")
}

model SocialPost {
  id          String    @id @default(cuid())
  userId      String
  spiritId    String?
  content     String
  imageUrl    String?
  platform    String    @default("FACEBOOK")
  postId      String?
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spirit      Spirit?   @relation(fields: [spiritId], references: [id], onDelete: SetNull)

  @@map("social_posts")
}

model PlayerLocation {
  userId     String   @id
  latitude   Float
  longitude  Float
  accuracy   Float?
  altitude   Float?
  speed      Float?
  heading    Float?
  lastUpdate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_locations")
}

model Hotspot {
  id         String   @id @default(cuid())
  name       String
  latitude   Float
  longitude  Float
  type       String
  popularity Int      @default(1)
  radius     Int      @default(100)
  spawnTypes String   @default("[]")
  bonusRate  Float    @default(1.0)
  peakHours  String   @default("[]")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, latitude, longitude])
  @@map("hotspots")
}

model LocationVisit {
  id          String        @id @default(cuid())
  userId      String
  locationId  String
  spiritId    String?
  spiritFound Boolean       @default(false)
  visitedAt   DateTime
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  location    LocationSpawn @relation(fields: [locationId], references: [id], onDelete: Cascade)
  spirit      Spirit?       @relation(fields: [spiritId], references: [id], onDelete: SetNull)

  @@map("location_visits")
}

model EnglishConversation {
  id              String   @id @default(cuid())
  userId          String
  spiritId        String?
  topicId         String?
  userMessage     String
  aiResponse      String
  detectedEmotion       String?
  emotionIntensity      Int?
  emotionalValidation   String?
  validationLocale      String?
  truthScore            Int?
  grammarFeedback String?
  vocabularyHint  String?
  pronunciation   String?
  score           Int?
  correctedText   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spirit          Spirit?  @relation(fields: [spiritId], references: [id], onDelete: SetNull)
  topic           EnglishTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("english_conversations")
}

model EnglishTopic {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  difficulty  String   @default("BEGINNER")
  prompts     String
  vocabulary  String?
  grammarTips String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  conversations EnglishConversation[]
  learningProgress EnglishLearningProgress[]

  @@map("english_topics")
}

model EnglishLearningProgress {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  totalSessions   Int      @default(0)
  completedSessions Int    @default(0)
  totalMessages   Int      @default(0)
  avgScore        Float    @default(0)
  lastSessionAt   DateTime?
  bestScore       Int?
  streakDays      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           EnglishTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("english_learning_progress")
}

model ActionLog {
  id          String   @id @default(cuid())
  userId      String
  actionType  String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("action_logs")
}

model ARCapture {
  id          String        @id @default(cuid())
  userId      String
  spiritId    String
  locationId  String
  latitude    Float
  longitude   Float
  arData      String
  captureTime Int
  accuracy    Float
  xpEarned    Int
  itemsFound  String
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spirit      Spirit        @relation(fields: [spiritId], references: [id], onDelete: Cascade)
  location    LocationSpawn @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("ar_captures")
}

model OpenSourceResource {
  id                    String                   @id @default(cuid())
  canonicalId           String                   @unique
  name                  String
  kind                  String
  role                  String                   @default("AUXILIARY_OPEN_SOURCE")
  sourceUrl             String
  version               String?
  licenseExpression     String                   @default("NOASSERTION")
  licenseUrl            String?
  attribution           String?
  contentSha256         String?
  contentIncluded       Boolean                  @default(false)
  policyReviewStatus    String                   @default("REVIEW_REQUIRED")
  legalReviewStatus     String                   @default("NOT_REVIEWED")
  ingestionStatus       String                   @default("METADATA_ONLY")
  decisionReason        String
  attributionRequired   Boolean                  @default(false)
  shareAlikeRequired    Boolean                  @default(false)
  commercialUseAllowed  Boolean                  @default(false)
  redistributionAllowed Boolean                  @default(false)
  modificationAllowed   Boolean                  @default(false)
  containsPersonalData  Boolean                  @default(false)
  containsSensitiveData Boolean                  @default(false)
  containsChildData     Boolean                  @default(false)
  isAuthoritative       Boolean                  @default(false)
  provenanceJson        String                   @default("{}")
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  chunks                OpenSourceContentChunk[]

  @@index([kind, ingestionStatus])
  @@index([licenseExpression])
  @@map("open_source_resources")
}

model OpenSourceContentChunk {
  id              String             @id @default(cuid())
  resourceId      String
  sequence        Int
  role            String             @default("AUXILIARY_OPEN_SOURCE")
  content         String
  contentSha256   String
  isAuthoritative Boolean            @default(false)
  createdAt       DateTime           @default(now())
  resource        OpenSourceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, sequence])
  @@index([resourceId])
  @@map("open_source_content_chunks")
}

model AccountAudit {
  id String @id @default(cuid())
  actorId String
  targetId String
  action String
  reason String
  previousActive Boolean
  resultingActive Boolean
  createdAt DateTime @default(now())
  @@index([targetId, createdAt])
  @@map("account_audits")
}

model SpiritMemory {
  id          String   @id @default(cuid())
  spiritId    String
  userId      String
  content     String
  category    String   @default("fact")
  importance  Int      @default(5)
  sourceConv  String?
  embedding   String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  spirit      Spirit   @relation(fields: [spiritId], references: [id], onDelete: Cascade)

  @@index([spiritId, importance])
  @@index([userId])
  @@map("spirit_memories")
}

model PaymentSubmission {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  amount         Int
  currency       String   @default("AUD")
  method         String   @default("bank_transfer")
  status         String   @default("PENDING")
  passportName   String?
  proofUrl       String?
  proofNote      String?
  adminNote      String?
  invoiceNumber  String?
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payment_submissions")
}

model UserWoocommerce {
  id         String   @id @default(cuid())
  userId     String   @unique
  wooUrl     String
  wooKey     String
  wooSecret  String
  shopName   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_woocommerce")
}