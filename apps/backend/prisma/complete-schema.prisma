  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  radius      Int      @default(500)
  type        String   @default("GENERAL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hotspots")
}

