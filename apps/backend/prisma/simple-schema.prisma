generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用戶模型
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         String   @default("PLAYER")
  trainerXp    Int      @default(0)
  trainerLevel Int      @default(1)
  gems         Int      @default(0)
  coins        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 關係
  LanguagePreference  LanguagePreference?
  UserSettings        UserSettings?
  PasswordResetToken  PasswordResetToken[]

  @@map("users")
}

// 語言設定
model LanguagePreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  primaryLang   String  @default("zh-TW")
  secondaryLang String?
  displayMode   String  @default("SINGLE")
  fontSize      Int     @default(16)
  theme         String  @default("LIGHT")
  autoDetect    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("language_preferences")
}

// 用戶設定
model UserSettings {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 音效設定
  musicVolume    Int     @default(70)
  soundVolume    Int     @default(80)
  musicEnabled   Boolean @default(true)
  soundEnabled   Boolean @default(true)
  
  // 震動設定
  vibrationEnabled Boolean @default(true)
  vibrationStrength Int    @default(50)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

// 密碼重置令牌
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}