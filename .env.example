# ────────────────────────────────────────────
# Nightasaur 環境設定
# ────────────────────────────────────────────

# --- 資料庫 ---
DATABASE_URL="file:./dev.db"

# --- JWT 認證 ---
JWT_SECRET="" # Required: independently generated random secret, at least 32 bytes
# User tokens expire after one hour; no configurable long-lived default.

# --- FB / IG API ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# --- AI 服務 ---
AI_ENGINE_URL="http://localhost:8000"
# Empty disables image inference; review exact weights and license before selecting.
COMFYUI_CHECKPOINT=""
COMFYUI_URL="http://localhost:8188"
OLLAMA_URL="http://localhost:11434"
# Empty disables text inference. Review exact model provenance/license first.
OLLAMA_MODEL=""
AI_ENGINE_API_KEY="" # Backend-to-AI service secret; never VITE_ or browser-visible
SOCIAL_PUBLISH_ENABLED="false"

# --- 伺服器 ---
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY_HOPS=0 # Set the exact proxy hop count; never use unrestricted trust.

# --- 上傳 ---
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50
