FROM node:20-slim

RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/shared/package.json packages/shared/package.json

COPY apps/web/package.json apps/web/package.json
COPY apps/mobile/package.json apps/mobile/package.json

RUN npm ci --ignore-scripts

COPY apps/backend apps/backend
COPY packages/shared packages/shared
COPY deploy/verify-production-ai.mjs deploy/verify-production-ai.mjs

RUN cd apps/backend && npx prisma generate --schema prisma/schema.prisma

ENV NODE_ENV=production
EXPOSE 3002

# Schema changes are a separate, reviewed operator action.
CMD ["node", "--import", "tsx", "apps/backend/src/index.ts"]
